/*
 * Lily58 Pro / nice!nano v2 — ZMK v0.3
 * 4 layers: QWERTY / LOWER (mouse + numpad) / RAISE (F-keys + nav) / ADJUST (tri-layer)
 * macOS oriented, coding + terminal focused.
 *
 * Shared by both halves. config/lily58_left.keymap and config/lily58_right.keymap
 * #include this file and then override &kscan0 for the flipped controller mount.
 * That override swaps GPIO *pads* positionally, so the logical matrix (and every
 * key position below) is unchanged from a normally-mounted board.
 *
 * Key positions (used by combos):
 *   left   0..5   12..17  24..29  36..41  42(inner)  50..53(thumbs)
 *   right  6..11  18..23  30..35  43(inner) 44..49    54..57(thumbs)
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/ext_power.h>

/* mouse speed — must be defined BEFORE the pointing include */
#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20
#include <dt-bindings/zmk/pointing.h>

#define QWERTY 0
#define LOWER  1
#define RAISE  2
#define ADJUST 3

#define HYPER LS(LC(LA(LGUI)))
#define MEH   LS(LC(LALT))

/* Positional hold-tap groups: a home-row mod only fires if the next key is on
   the OTHER hand (or a thumb). Kills the "typed a letter, got a modifier" bug. */
#define KEYS_L 0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 42
#define KEYS_R 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 43 44 45 46 47 48 49
#define THUMBS 50 51 52 53 54 55 56 57

/ {
    behaviors {
        /* home-row mods */
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };

        /* brackets on letter holds (same hand, so tap-preferred:
           the hold only fires after the full tapping term) */
        br: bracket_hold {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
        };

        /* 3 taps to reflash / reset — stops a fat finger nuking the session */
        td_boot: tap_dance_bootloader {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&none>, <&none>, <&bootloader>;
        };

        td_reset: tap_dance_reset {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&none>, <&none>, <&sys_reset>;
        };

        /* layer-tap with a quick-tap window so double-tap-and-hold repeats the tap */
        lt_tuned: layer_tap_tuned {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&mo>, <&kp>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    combos {
        compatible = "zmk,combos";

        /* JK -> esc (vim reflex) */
        combo_esc {
            timeout-ms = <45>;
            require-prior-idle-ms = <125>;
            key-positions = <31 32>;
            bindings = <&kp ESC>;
            layers = <QWERTY>;
        };

        /* KL -> -  (shift gives _) */
        combo_minus {
            timeout-ms = <45>;
            require-prior-idle-ms = <125>;
            key-positions = <32 33>;
            bindings = <&kp MINUS>;
            layers = <QWERTY>;
        };

        /* L; -> =  (shift gives +) */
        combo_equal {
            timeout-ms = <45>;
            require-prior-idle-ms = <125>;
            key-positions = <33 34>;
            bindings = <&kp EQUAL>;
            layers = <QWERTY>;
        };

        /* ,. -> delete previous word */
        combo_del_word {
            timeout-ms = <45>;
            require-prior-idle-ms = <125>;
            key-positions = <46 47>;
            bindings = <&kp LA(BSPC)>;
            layers = <QWERTY>;
        };

        /* CV -> adjust layer without the two-thumb chord */
        combo_adjust {
            timeout-ms = <50>;
            key-positions = <39 40>;
            bindings = <&mo ADJUST>;
            layers = <QWERTY>;
        };

        /* both shifts -> caps word (SCREAMING_SNAKE_CASE) */
        combo_caps_word {
            timeout-ms = <60>;
            key-positions = <36 49>;
            bindings = <&caps_word>;
            layers = <QWERTY>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        qwerty_layer {
            display-name = "QWERTY";
            bindings = <
&kp GRAVE  &kp N1       &kp N2       &kp N3        &kp N4        &kp N5                                    &kp N6        &kp N7        &kp N8        &kp N9        &kp N0            &mt DEL BSPC
&kp TAB    &kp Q        &kp W        &br LBRC E    &br LBKT R    &br LPAR T                                &br RPAR Y    &br RBKT U    &br RBRC I    &kp O         &kp P             &kp BSLH
&kp LCTRL  &hml LGUI A  &hml LALT S  &kp D         &kp F         &kp G                                     &br GRAVE H   &kp J         &hmr RGUI K   &hmr RALT L   &hmr RCTRL SEMI   &kp SQT
&kp LSHFT  &kp Z        &kp X        &kp C         &kp V         &kp B       &mt HYPER ESC   &mt MEH BSPC   &kp N         &kp M         &kp COMMA     &kp DOT       &kp FSLH          &kp RSHFT
                                     &kp LALT      &mo LOWER     &lt_tuned RAISE ESC  &kp RET      &kp SPACE     &lt_tuned LOWER TAB   &mo RAISE     &kp BSPC
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        lower_layer {
            display-name = "LOWER";
            bindings = <
&kp ESC    &none        &msc SCRL_LEFT  &msc SCRL_UP     &msc SCRL_RIGHT  &msc SCRL_DOWN                    &kp LPAR      &kp N7        &kp N8        &kp N9        &kp MINUS     &kp BSPC
&trans     &none        &none           &mmv MOVE_UP     &none            &none                             &kp RPAR      &kp N4        &kp N5        &kp N6        &kp PLUS      &kp PRCNT
&trans     &none        &mmv MOVE_LEFT  &mmv MOVE_DOWN   &mmv MOVE_RIGHT  &none                             &kp LT        &kp N1        &kp N2        &kp N3        &kp SLASH     &kp CARET
&trans     &mkp MB4     &mkp MCLK       &mkp LCLK        &mkp RCLK        &mkp MB5    &kp DEL   &kp RET      &kp GT        &kp N0        &kp DOT       &kp EQUAL     &kp ASTRK     &kp RET
                                        &trans           &trans           &trans      &kp LGUI      &kp SPACE     &trans        &trans        &kp DEL
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        raise_layer {
            display-name = "RAISE";
            bindings = <
&kp F1     &kp F2       &kp F3       &kp F4        &kp F5        &kp F6                                     &kp LG(LS(LBKT)) &kp PG_DN  &kp PG_UP     &kp LG(LS(RBKT)) &kp LC(UP)  &kp DEL
&kp F7     &kp F8       &kp F9       &kp F10       &kp F11       &kp F12                                    &kp HOME      &kp LG(DOWN)  &kp LG(UP)    &kp END       &kp LG(LBKT)  &kp LG(RBKT)
&trans     &kp LGUI     &kp LALT     &kp LSHFT     &kp LCTRL     &none                                      &kp LEFT      &kp DOWN      &kp UP        &kp RIGHT     &kp LC(LEFT)  &kp LC(RIGHT)
&trans     &kp LG(Z)    &kp LG(X)    &kp LG(C)     &kp LG(V)     &kp LG(LS(Z)) &trans        &trans          &kp LA(LEFT)  &kp LA(RIGHT) &kp LG(LEFT)  &kp LG(RIGHT) &kp LG(GRAVE) &trans
                                     &kp LALT      &trans        &trans        &kp LGUI          &trans        &trans        &trans        &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        adjust_layer {
            display-name = "ADJUST";
            bindings = <
&bt BT_CLR      &bt BT_SEL 0      &bt BT_SEL 1       &bt BT_SEL 2       &bt BT_SEL 3  &bt BT_SEL 4                       &none         &kp C_BRI_DN  &kp C_BRI_UP  &none         &none         &none
&bt BT_CLR_ALL  &out OUT_USB      &out OUT_BLE       &out OUT_TOG       &none         &none                              &kp C_PREV    &kp C_VOL_DN  &kp C_VOL_UP  &kp C_NEXT    &none         &none
&studio_unlock  &ext_power EP_ON  &ext_power EP_OFF  &ext_power EP_TOG  &none         &none                              &kp C_MUTE    &kp C_PP      &kp C_STOP    &none         &caps_word    &key_repeat
&none           &td_boot          &td_reset          &none              &tog LOWER    &none         &none     &none      &none         &td_reset     &td_boot      &none         &kp LG(LC(Q)) &none
                                                     &none              &trans        &trans        &none         &none         &trans        &trans        &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
